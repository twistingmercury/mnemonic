# Local development environment for the Mnemonic services (api, mcp, enricher).
#
# Copy to .env and edit; .env is git-ignored. Services read every variable as
# MNEMONIC_ + the config key path with dots replaced by underscores, upper-cased
# (config key database.postgres.host -> MNEMONIC_DATABASE_POSTGRES_HOST).
# Anything left out falls back to the default in src/internal/<service>/config/.
#
# Not set here on purpose: MNEMONIC_SERVER_PORT and the metrics port. All three
# services default to the same ports, so set them per process when you run more
# than one on the same host.
#
# Image build metadata (MNEMONIC_BUILD_VER, MNEMONIC_BUILD_COMMIT,
# MNEMONIC_BUILD_DATE) is computed by build/*.build.sh. Export those only to
# override a build; they are not runtime settings.

# --- Shared by api, mcp and enricher -----------------------------------------

# Logging level: debug, info, warn or error.
MNEMONIC_LOGGING_LEVEL=debug

# PostgreSQL. Host port 5435 is what db/docker-compose.yaml publishes.
MNEMONIC_DATABASE_POSTGRES_HOST=localhost
MNEMONIC_DATABASE_POSTGRES_PORT=5435
MNEMONIC_DATABASE_POSTGRES_DATABASE=mnemonic
MNEMONIC_DATABASE_POSTGRES_USERNAME=mnemonic
MNEMONIC_DATABASE_POSTGRES_PASSWORD=mnemonic_dev
MNEMONIC_DATABASE_POSTGRES_SSL_MODE=disable

# Neo4j. Host port 7690 is what db/docker-compose.yaml publishes.
MNEMONIC_DATABASE_NEO4J_URI=bolt://localhost:7690
MNEMONIC_DATABASE_NEO4J_USERNAME=neo4j
MNEMONIC_DATABASE_NEO4J_PASSWORD=mnemonic_dev
MNEMONIC_DATABASE_NEO4J_DATABASE=neo4j

# OpenAI API key. Leave it empty: the real key is never put in this file.
# In the full stack every OpenAI call goes through the egress proxy, and only
# the egress service holds the real key. It reads the host variable
# MNEMONIC_OPENAI_API_EMBEDDINGS_KEY (also used by `make k8s-secret`), which you
# export in your own shell and which the services deliberately ignore.
MNEMONIC_OPENAI_API_KEY=
# To use the egress proxy or an OpenAI-compatible stub, set the base URL:
# MNEMONIC_OPENAI_BASE_URL=http://localhost:PORT/v1

# --- api and enricher --------------------------------------------------------

# RabbitMQ job queue.
MNEMONIC_QUEUE_RABBITMQ_HOST=localhost
MNEMONIC_QUEUE_RABBITMQ_PORT=5672
MNEMONIC_QUEUE_RABBITMQ_USER=guest
MNEMONIC_QUEUE_RABBITMQ_PASSWORD=guest
MNEMONIC_QUEUE_RABBITMQ_VHOST=/
MNEMONIC_QUEUE_RABBITMQ_QUEUE=enrichment-jobs

# --- mcp ---------------------------------------------------------------------

# Minimum similarity for a search hit (default 0.5).
MNEMONIC_MCP_DEFAULT_SEARCH_THRESHOLD=0.5

# --- enricher ----------------------------------------------------------------

MNEMONIC_ENRICHMENT_WORKER_COUNT=2
MNEMONIC_OPENAI_EXTRACTION_MODEL=gpt-4o-mini
